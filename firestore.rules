rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validProfile(d) {
      return d.keys().hasAll(['fullName', 'email', 'role', 'authProvider', 'createdAt'])
        && d.keys().hasOnly(['fullName', 'email', 'role', 'authProvider', 'createdAt', 'phone', 'avatarUrl'])
        && d.fullName is string && d.fullName.size() >= 2 && d.fullName.size() <= 100
        && d.email is string && d.role in ['CUSTOMER', 'ADMIN']
        && d.authProvider in ['LOCAL', 'GOOGLE'] && d.createdAt is timestamp
        && (!('phone' in d) || d.phone == null || (d.phone is string && d.phone.size() <= 20))
        && (!('avatarUrl' in d) || d.avatarUrl == null || (d.avatarUrl is string && d.avatarUrl.size() <= 2048));
    }
    match /users/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid) && validProfile(request.resource.data)
        && request.resource.data.role == 'CUSTOMER'
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.createdAt == request.time;
      allow update: if owner(uid) && validProfile(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'phone', 'avatarUrl']);
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
